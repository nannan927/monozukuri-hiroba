{
  "name": "monozukuri-hiroba-geek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/build-cms.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "deploy": "npm run check && npm run build && npm run test:cms && npx --yes wrangler@4.157.0 pages deploy dist --project-name monozukuri-hiroba-tomo --branch main",
    "render:autumn": "node scripts/render-autumn-dusk.mjs",
    "test:autumn": "node --test scripts/autumn-dusk.test.mjs",
    "test:cms": "node --test scripts/cms.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/rss": "4.0.19",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "astro": "7.4.5",
    "marked": "^18.1.3",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@napi-rs/canvas": "1.1.0",
    "@types/sanitize-html": "^2.16.2",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.3"
  }
}
