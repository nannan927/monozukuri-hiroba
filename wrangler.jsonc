{
  "name": "monozukuri-hiroba-tomo",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "FEDERATION_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "FEDERATION_KV",
      "id": "cf09d98691e0486ebd9be96064bb6861"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FEDERATION_QUEUE",
        "queue": "monozukuri-hiroba-federation"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monozukuri-hiroba-content",
      "database_id": "3c284235-a1ab-4ea6-8b13-f9234b337ad9",
      "migrations_dir": "migrations"
    }
  ]
}
