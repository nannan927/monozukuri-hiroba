{
  "name": "monozukuri-hiroba-federation",
  "main": "cms/federation-consumer.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"FEDERATION_ENABLED": "true"},
  "triggers": {"crons": ["*/5 * * * *"]},
  "d1_databases": [{"binding":"DB","database_name":"monozukuri-hiroba-content","database_id":"3c284235-a1ab-4ea6-8b13-f9234b337ad9","migrations_dir":"migrations"}],
  "kv_namespaces": [{"binding":"FEDERATION_KV","id":"00000000000000000000000000000000"}],
  "queues": {
    "producers": [{"binding":"FEDERATION_QUEUE","queue":"monozukuri-hiroba-federation"}],
    "consumers": [{"queue":"monozukuri-hiroba-federation","max_batch_size":5,"max_batch_timeout":5,"max_retries":8}]
  }
}
