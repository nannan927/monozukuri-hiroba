---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWorks } from '../lib/content';
const works = (await getWorks()).filter(work => work.data.tags.includes('文学'));
---
<Layout title="文学"><header class="page-intro"><div class="breadcrumb"><a href="/">ホーム</a><span>/</span><a href="/writing/">文章</a><span>/</span><span>文学</span></div><p class="page-kicker">LITERATURE</p><h1>文学</h1></header><section class="archive" aria-label="文学の一覧"><p class="sample-note">{works.length}件</p><div class="works-grid">{works.map(work => <WorkCard work={work} />)}</div></section></Layout>
