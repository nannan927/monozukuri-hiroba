---
import Layout from '../layouts/Layout.astro';
import {getWorks,categories} from '../lib/content';
import {externalLinks} from '../data/external-links';
import {renderHome} from '../lib/editorial-home';
const posts=(await getWorks()).map(p=>({...p.data,slug:p.id,date:p.data.date.toISOString().slice(0,10)}));
---
<Layout><Fragment set:html={renderHome(posts,externalLinks,categories)} /></Layout>
