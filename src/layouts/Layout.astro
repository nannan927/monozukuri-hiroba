---
import '@fontsource/noto-serif-jp/400.css';
import '@fontsource/cormorant-garamond/400.css';
import '../styles/global.css';
import '../styles/editorial.css';
import { categories } from '../lib/content';
interface Props { title?: string; description?: string }
const { title, description = '文章・仕事・絵画・音楽・映像・研究・開発の個人サイト。' } = Astro.props;
const current = Astro.url.pathname;
const pageTitle = title ? `${title} | ものづくり広場` : 'ものづくり広場';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={new URL(current, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="ものづくり広場" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={new URL(current, Astro.site)} />

  </head>
  <body id="hiroba-glyphs">
    <a class="skip-link" href="#main">本文へ進む</a>
    <div class="hg-wrap">
      <header class="hg-header">
        <a class="hg-brand" href="/" aria-label="ものづくり広場 ホーム"><span class="hg-mark" aria-hidden="true">m</span>ものづくり広場</a>
        <nav class="main-nav hg-nav" aria-label="メインメニュー">
          {categories.map(c => <a class:list={{ active: current.startsWith(`/${c.id}/`) }} href={`/${c.id}/`} aria-current={current.startsWith(`/${c.id}/`) ? 'page' : undefined}>{c.name}</a>)}
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer hg-footer"><small>© {new Date().getFullYear()} ものづくり広場</small><div><a href="/search/">検索</a><a href="/works/">全作品</a><a href="/creative/">創作</a><a href="/literature/">文学</a><a href="/now/">/now</a><a href="/about/">このサイトについて</a><a href="/rss.xml">RSS</a><span aria-hidden="true">/</span><a href="#main">↑ top</a></div></footer>
    </div>

  </body>
</html>
